# Build context hygiene: everything here is either regenerated by npm, machine-local, or a
# secret. Keep this list honest — the image copies the workspace manifests explicitly, so a
# missing entry only wastes build time, while a wrong one (e.g. apps/**/package.json) breaks
# `npm ci` inside the build.

node_modules
**/node_modules
npm-debug.log*
.install.log
*.log

.git
.gitignore
.github

# never bake local state or credentials into an image
.env
.env.*
!.env.example
.data
**/.data
coverage
dist
build
.next
**/.next
tmp

# documentation and tests are not needed to run (the API tier has no build step)
docs
tests
**/*.test.ts
Dockerfile
docker-compose.yml
.dockerignore
README.md
