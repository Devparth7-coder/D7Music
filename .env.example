# ============================================================================
#  D7music — environment contract
#
#  Copy to `.env` (git-ignored) and edit. `.env.local` overrides `.env`.
#  Every integration is OPT-IN: leaving a value empty disables that feature and
#  the app says so in /api/health and the UI instead of pretending to work.
#
#  Format is strict KEY=VALUE with one assignment per line and no inline comments,
#  because `docker run --env-file`, systemd EnvironmentFile= and docker compose all
#  parse this file differently from a shell — a trailing "# note" becomes part of the
#  value in two of the three.
#
#  This file lists *every* variable the app reads, set to its built-in default.
#  `node scripts/check-env-docs.mjs` fails if that ever stops being true.
#  Long-form explanation: docs/ENVIRONMENT.md
# ============================================================================

# development | test | production
NODE_ENV=development
# fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# ---------------- API server ----------------
API_HOST=0.0.0.0
API_PORT=4000
# Public origin of the API, no trailing slash. Signed stream URLs and OAuth
# callbacks are built from it, so it must be the URL the *browser* can reach.
API_PUBLIC_URL=http://localhost:4000
# Exact browser origin allowed to send cookies. CORS and the CSRF Origin check
# both compare against this string — in production it must be the real https
# origin, not a wildcard and not a port-less alias.
WEB_ORIGIN=http://localhost:3000
# Parse X-Forwarded-For for request.ip. Enable ONLY when every request arrives
# through a proxy you control (nginx/ALB/Cloudflare): the anonymous rate limiter
# keys on request.ip, so a client that can inject these headers picks its own
# rate-limit bucket.
TRUST_PROXY=false
# The API applies pending migrations at boot: idempotent and checksum-guarded, so a
# restart is safe. On a platform that starts replicas without warning, set false and
# migrate from the build step / CI instead.
API_MIGRATE_AT_BOOT=true
# 32+ random chars. Signs session JWTs and stream URLs. Boot fails in production
# if this is still the built-in default.
APP_SECRET=change-me-to-a-long-random-string-0123456789abcdef
SESSION_TTL_DAYS=30
# 11 ≈ 250 ms on a 2 vCPU box; raise as hardware allows
BCRYPT_ROUNDS=11

# ---------------- Database ----------------
# postgres = real server (the only supported production driver)
# pglite   = embedded PostgreSQL (dev/test: real SQL engine, single writer, no server)
DB_DRIVER=pglite
DATABASE_URL=
# DATABASE_URL=postgres://d7:d7@localhost:5432/d7music?sslmode=require
PGLITE_DIR=.data/pglite
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# ---------------- Cache / queue ----------------
# Empty = in-process LRU cache + Postgres-backed job queue (works in production
# for a single node, and for many nodes as long as one process runs the worker).
# Set it to share cached shelves across nodes and to switch the queue to BullMQ.
# Cross-process *locks* (job coalescing) only exist with Redis.
REDIS_URL=
# key prefix; set per environment sharing one Redis
QUEUE_NAMESPACE=d7music
CACHE_TTL_HOME_SEC=20
CACHE_TTL_CATALOG_SEC=240

# ---------------- Audio storage (bytes never live in Postgres) ----------------
# local | s3 (any S3-compatible endpoint)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# Public base URL of a CDN/front door for *public* objects (artwork). Empty =
# the API serves them under /media/*. Streams are always signed, either way.
STORAGE_PUBLIC_BASE_URL=
# https://s3.us-east-1.wasabisys.com, minio, R2, …
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# false for AWS, true for most S3-compatible hosts
S3_FORCE_PATH_STYLE=true
# signed stream lifetime; 6 h
STREAM_URL_TTL_SEC=21600
# 302 clients to the storage provider's presigned URL instead of streaming the bytes
# here. Only useful with a bucket on another origin (S3/R2): the local driver's signed
# URLs point back at this API, and those stay proxied.
STREAM_REDIRECT=false

# ---------------- MUSIC (audio) provider — pick ONE ----------------
# local_library : platform-owned uploads + seeded catalog (default, no credentials)
# json_http     : any licensed partner catalogue API (docs/PROVIDERS.md)
# none          : no external audio; only uploaded/licensed tracks are playable
MUSIC_PROVIDER=local_library
MUSIC_PROVIDER_BASE_URL=
MUSIC_PROVIDER_API_KEY=
MUSIC_PROVIDER_TIMEOUT_MS=12000
# client-side throttle; 1 is required by some APIs
MUSIC_PROVIDER_RPS=2
# only retryable statuses (429, 5xx, network)
MUSIC_PROVIDER_MAX_RETRIES=4
# field mapping for json_http (docs/PROVIDERS.md)
MUSIC_PROVIDER_MAP_JSON=
# endpoint overrides for json_http
MUSIC_PROVIDER_ENDPOINTS_JSON=
# provider album ids to import on first sync
MUSIC_PROVIDER_SEED_IDS=

# ---------------- METADATA / discovery providers (comma separated) ----------------
# Metadata only: can never make unlicensed audio playable.
# e.g. musicbrainz
METADATA_PROVIDERS=
MUSICBRAINZ_USER_AGENT=D7music/0.1 (mailto:you@example.com)
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2

# ---------------- Release sync job ----------------
# Runs inside the API and inside `npm run worker`. With more than one of those
# alive, set this to false everywhere except the dedicated worker.
RELEASE_SYNC_ENABLED=true
RELEASE_SYNC_INTERVAL_MIN=360
RELEASE_SYNC_PAGE_SIZE=50
RELEASE_SYNC_LOOKBACK_DAYS=45
RELEASE_SYNC_MAX_ALBUMS_PER_RUN=150

# ---------------- Scheduled jobs (external scheduler, e.g. Vercel Cron) ----------------
# Bearer token for GET /api/jobs/<job>. Left empty, that endpoint answers 501; there
# is no unauthenticated way to trigger a job. Vercel sends this header automatically
# when the project has a secret named exactly CRON_SECRET.
CRON_SECRET=

# ---------------- Recommendations ----------------
RECAND_WINDOW_DAYS=60
RECAND_CANDIDATE_LIMIT=400
RECAND_WEIGHT_ARTIST=1.6
RECAND_WEIGHT_GENRE=1.0
RECAND_WEIGHT_LIKES=1.4
RECAND_WEIGHT_FREQUENCY=1.2
RECAND_WEIGHT_RECENCY=0.9
RECAND_WEIGHT_POPULARITY=0.7
RECAND_SKIP_PENALTY=1.1
RECOMMENDATION_UPDATE_INTERVAL_MIN=180

# ---------------- AI assistant ----------------
# Leave LLM_* empty to use the built-in deterministic NL→query parser.
# Set them to route intent parsing through an OpenAI-compatible endpoint; the
# model output is validated with zod and every id is resolved against our
# catalog, so it can never invent songs.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000
ASSISTANT_DAILY_LIMIT_FREE=10
ASSISTANT_DAILY_LIMIT_PREMIUM=500

# ---------------- Auth ----------------
# Comma separated list of enabled OAuth providers (google,github,oidc).
# Register the redirect URL: {API_PUBLIC_URL}/api/auth/oauth/<provider>/callback
OAUTH_PROVIDERS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3000

# ---------------- Mail (password reset / verification) ----------------
# No SMTP client is bundled: messages are written to MAIL_OUTBOX_DIR as JSON and
# the log says so. Point this at a real transport by wiring deliver() in
# apps/api/src/lib/mail.ts (see docs/DEPLOYMENT.md §Mail).
SMTP_URL=
MAIL_FROM=D7music <no-reply@d7music.local>
MAIL_OUTBOX_DIR=.data/outbox

# ---------------- Payments (abstraction; no real charging by default) ----------------
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------- Rate limiting ----------------
# Fixed window per 60 s keyed by user id (or IP when anonymous), enforced in the
# cache layer — so limits are shared across nodes only when REDIS_URL is set.
# tests / single-user dev box only
RATE_LIMIT_DISABLED=false
RATE_LIMIT_AUTH=12
RATE_LIMIT_WRITE=90
RATE_LIMIT_SEARCH=150
RATE_LIMIT_PLAYBACK=600
RATE_LIMIT_ASSISTANT=40
# creator audio/artwork uploads (also enforced by multipart limits)
UPLOAD_MAX_MB=60

# ---------------- Content safety ----------------
# The two flags that keep this platform legal. Turning either off is a
# conscious, logged decision — unlicensed streaming is never the default.
ALLOW_UNLICENSED_STREAM=false
REQUIRE_LICENSE_FOR_UPLOAD=true
# Where a user is told to appeal a content report. Empty = no appeal link.
REPORT_REVIEW_URL=

# ---------------- Seed accounts (never run db:seed against production) ----------------
SEED_ADMIN_EMAIL=admin@d7music.test
SEED_ADMIN_PASSWORD=D7admin!234
SEED_DEMO_EMAIL=demo@d7music.test
SEED_DEMO_PASSWORD=D7demo!2345
